# Argus — clawhip config example.
# Real config lives at $HOME/.clawhip/config.toml (NOT in this repo).
# Webhook URLs come from $HOME/.argus/secrets.env at install time.

[providers.discord]
# Phase A: webhook-only. No bot token. Bot setup deferred to Phase B.

[dispatch]
routine_batch_window_secs = 5
ci_batch_window_secs = 60

# INFO-tier: routine traffic to #runs-info via webhook
[[routes]]
event = "git.commit"
sink = "discord"
url = "REPLACE_WITH_CLAWHIP_DISCORD_WEBHOOK_RUNS_INFO"
format = "compact"

[[routes]]
event = "agent.*"
sink = "discord"
url = "REPLACE_WITH_CLAWHIP_DISCORD_WEBHOOK_RUNS_INFO"
format = "compact"

[[routes]]
event = "session.*"
sink = "discord"
url = "REPLACE_WITH_CLAWHIP_DISCORD_WEBHOOK_RUNS_INFO"
format = "compact"

# Phase B: route gate.pending and tier escalation events to the telegram bridge.
# The bridge listens on http://127.0.0.1:9501 (BRIDGE_HOST/BRIDGE_PORT in
# scripts/telegram-bridge/launchd plist). Localhost-only — no secret in the URL.

[[routes]]
event = "gate.pending"
sink = "webhook"
url = "http://127.0.0.1:9501/webhook/gate"
format = "compact"

[[routes]]
event = "gate.timeout"
sink = "webhook"
url = "http://127.0.0.1:9501/webhook/page"
format = "compact"

# Approved gates close the loop with a low-noise INFO posting to Discord —
# operators can scroll the channel and see "approved at 14:03 by @marian".
[[routes]]
event = "gate.approved"
sink = "discord"
url = "REPLACE_WITH_CLAWHIP_DISCORD_WEBHOOK_RUNS_INFO"
format = "compact"

# WARN-tier events (degraded but progressing) go to Discord; Phase C may
# escalate these to the bridge if operators ask for tighter feedback.
[[routes]]
event = "agent.failed"
sink = "discord"
url = "REPLACE_WITH_CLAWHIP_DISCORD_WEBHOOK_RUNS_INFO"
format = "compact"

[[routes]]
event = "omc.rate-limit-pause"
sink = "discord"
url = "REPLACE_WITH_CLAWHIP_DISCORD_WEBHOOK_RUNS_INFO"
format = "compact"

# Phase C: cost-tracker threshold events
[[routes]]
event = "cost.warn"
sink = "discord"
url = "REPLACE_WITH_CLAWHIP_DISCORD_WEBHOOK_RUNS_INFO"
format = "compact"

[[routes]]
event = "cost.page"
sink = "webhook"
url = "http://127.0.0.1:9501/webhook/page"
format = "compact"

[[routes]]
event = "cost.kill"
sink = "webhook"
url = "http://127.0.0.1:9501/webhook/critical"
format = "compact"

# Phase C Block 3 — recovery automation routes.
# argus-recovery serves on http://127.0.0.1:9601 (loopback only,
# launchd KeepAlive=true). It receives tmux.stale + provider.outage
# events and runs the corresponding recovery script.

[[routes]]
event = "tmux.stale"
sink = "webhook"
url = "http://127.0.0.1:9601/tmux-restart"
format = "compact"

[[routes]]
event = "provider.outage"
sink = "webhook"
url = "http://127.0.0.1:9601/provider-fallback"
format = "compact"

# Recovery emits agent.loop-exhausted, agent.fake-completion,
# tmux.restart-attempted/failed/exhausted/rejected, provider.fallback-engaged,
# provider.fallback-unavailable, provider.outage-prolonged, and
# crash-budget-exhausted. WARNs go to Discord; PAGE/CRITICAL go to the
# bridge for Telegram fan-out.

[[routes]]
event = "agent.loop-exhausted"
sink = "discord"
url = "REPLACE_WITH_CLAWHIP_DISCORD_WEBHOOK_RUNS_INFO"
format = "compact"

[[routes]]
event = "agent.fake-completion"
sink = "discord"
url = "REPLACE_WITH_CLAWHIP_DISCORD_WEBHOOK_RUNS_INFO"
format = "compact"

[[routes]]
event = "tmux.restart-attempted"
sink = "discord"
url = "REPLACE_WITH_CLAWHIP_DISCORD_WEBHOOK_RUNS_INFO"
format = "compact"

[[routes]]
event = "tmux.restart-exhausted"
sink = "webhook"
url = "http://127.0.0.1:9501/webhook/page"
format = "compact"

[[routes]]
event = "provider.fallback-engaged"
sink = "discord"
url = "REPLACE_WITH_CLAWHIP_DISCORD_WEBHOOK_RUNS_INFO"
format = "compact"

[[routes]]
event = "provider.fallback-unavailable"
sink = "webhook"
url = "http://127.0.0.1:9501/webhook/page"
format = "compact"

[[routes]]
event = "provider.outage-prolonged"
sink = "webhook"
url = "http://127.0.0.1:9501/webhook/page"
format = "compact"

[[routes]]
event = "crash-budget-exhausted"
sink = "webhook"
url = "http://127.0.0.1:9501/webhook/critical"
format = "compact"

# Phase C will add: harness.regression -> bridge /webhook/critical,
# clawhip.dead-man -> bridge /webhook/critical, host.rebooted -> bridge /webhook/critical, etc.
