{{ ansible_managed | comment }}
# Argus — secrets file. Sourced by run.sh wrappers (telegram-bridge, etc.).
# Mode 0600. Vault-rendered by ansible — do NOT edit by hand on the VPS.

# --- Telegram bridge -----------------------------------------------------
TELEGRAM_BOT_TOKEN={{ vault_telegram_bot_token }}
TELEGRAM_CHAT_ID_INFO={{ vault_telegram_chat_id_info }}
TELEGRAM_CHAT_ID_WARN={{ vault_telegram_chat_id_warn }}
TELEGRAM_CHAT_ID_PAGE={{ vault_telegram_chat_id_page }}
TELEGRAM_CHAT_ID_CRITICAL={{ vault_telegram_chat_id_critical }}
TELEGRAM_CHAT_ID_GATES={{ vault_telegram_chat_id_gates }}
TELEGRAM_WEBHOOK_SECRET={{ vault_telegram_webhook_secret }}

# --- clawhip Discord webhook --------------------------------------------
CLAWHIP_DISCORD_WEBHOOK_RUNS_INFO={{ vault_clawhip_discord_webhook }}

# --- Anthropic API + Claude Code OAuth ----------------------------------
{% if vault_anthropic_api_key is defined and vault_anthropic_api_key | length > 0 %}
ANTHROPIC_API_KEY={{ vault_anthropic_api_key }}
{% endif %}
{% if vault_claude_code_oauth_token is defined and vault_claude_code_oauth_token | length > 0 %}
CLAUDE_CODE_OAUTH_TOKEN={{ vault_claude_code_oauth_token }}
{% endif %}
